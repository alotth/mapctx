+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "mapctx-canonical-validate-"))
+  const storeDir = path.join(dir, "projects", crypto.randomUUID())
+  const handle = StoreHandle.open(storeDir)
+  handle.appendEvent({
+    eventType: "project.initialized",
+    actor: "test",
