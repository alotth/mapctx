+// ---- T-120 acceptance revision + criteria ----
+
+export function upsertAcceptanceRevision(db: DatabaseSync, input: {
+  taskId: string;
+  revision: number;
+  condition: "criteria" | "empty";
+  revisionEventNode: string;
+  revisionEventSequence: number;
