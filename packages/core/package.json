{
  "name": "@mapctx/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared task model, parser, and rendering helpers",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "thread": [
        "./dist/thread.d.ts"
      ],
      "workspace": [
        "./dist/workspace.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./thread": {
      "types": "./dist/thread.d.ts",
      "require": "./dist/thread.js",
      "default": "./dist/thread.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "require": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^24.5.2"
  }
}
