{
  "$ref": "#/definitions/Money",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amountMinor": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "decimals": {
          "maximum": 18,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "amountMinor",
        "currency",
        "decimals"
      ],
      "type": "object"
    }
  }
}
