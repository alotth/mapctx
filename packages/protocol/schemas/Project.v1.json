{
  "$ref": "#/definitions/Project",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Project": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "plansAuthority": {
          "enum": [
            "markdown",
            "store"
          ],
          "type": "string"
        },
        "repoBindings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "defaultRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "url",
              "path",
              "defaultRef"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "sourceMode": {
          "enum": [
            "local-canonical",
            "github-canonical"
          ],
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "workflowPolicy": {
          "additionalProperties": false,
          "properties": {
            "policySource": {
              "minLength": 1,
              "type": "string"
            },
            "profile": {
              "minLength": 1,
              "type": "string"
            },
            "requiredGates": {
              "items": {
                "enum": [
                  "product-review",
                  "architecture",
                  "program-design",
                  "vertical-slices"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "profile",
            "policySource",
            "requiredGates"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "title",
        "repoBindings",
        "workflowPolicy",
        "sourceMode",
        "plansAuthority"
      ],
      "type": "object"
    }
  }
}
