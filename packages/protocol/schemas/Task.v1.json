{
  "$ref": "#/definitions/Task",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Task": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "detailPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "due": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "pattern": "^[TE]-\\d{3,}$",
          "type": "string"
        },
        "parentId": {
          "anyOf": [
            {
              "pattern": "^[TE]-\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "planningState": {
          "enum": [
            "backlog",
            "ready",
            "blocked",
            "in-progress",
            "review",
            "paused",
            "done",
            "cancelled"
          ],
          "type": "string"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "specMode": {
          "anyOf": [
            {
              "enum": [
                "lite",
                "standard",
                "strict"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "epic",
            "feature",
            "task",
            "bug",
            "chore"
          ],
          "type": "string"
        },
        "workload": {
          "anyOf": [
            {
              "enum": [
                "Easy",
                "Normal",
                "Hard",
                "Extreme"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "parentId",
        "planningState",
        "priority",
        "workload",
        "tags",
        "domains",
        "start",
        "due",
        "acceptance",
        "specMode",
        "detailPath"
      ],
      "type": "object"
    }
  }
}
