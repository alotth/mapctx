{
  "$ref": "#/definitions/UsageEvent",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "UsageEvent": {
      "additionalProperties": false,
      "properties": {
        "cacheTokens": {
          "minimum": 0,
          "type": "integer"
        },
        "coverage": {
          "enum": [
            "full",
            "partial",
            "none"
          ],
          "type": "string"
        },
        "dispatchId": {
          "format": "uuid",
          "type": "string"
        },
        "inputTokens": {
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "type": "string"
        },
        "outputTokens": {
          "minimum": 0,
          "type": "integer"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "enum": [
            "harness-transcript",
            "provider-api",
            "manual",
            "absent"
          ],
          "type": "string"
        },
        "usageEventId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "usageEventId",
        "dispatchId",
        "provider",
        "model",
        "inputTokens",
        "cacheTokens",
        "outputTokens",
        "source",
        "coverage"
      ],
      "type": "object"
    }
  }
}
